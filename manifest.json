{
  "manifest_version": 3,
  "name": "Wishlist Exporter for Steam Next Fest",
  "short_name": "Wishlist x Next Fest",
  "version": "1.0.0",
  "description": "Export your Steam wishlist to a Google Sheets-ready CSV, flagging games in Next Fest. Unofficial; not affiliated with Valve.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://store.steampowered.com/*",
    "https://api.steampowered.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Export wishlist + Next Fest",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  }
}
